[
 {
  "start": 0.0,
  "end": 1.0,
  "text": "先生您要喝汤吗"
 },
 {
  "start": 1.0,
  "end": 2.25,
  "text": "不过现在要排队"
 },
 {
  "start": 2.5,
  "end": 4.75,
  "text": "师傅这汤是您熬的"
 },
 {
  "start": 6.75,
  "end": 8.0,
  "text": "我能尝一碗吗"
 },
 {
  "start": 9.0,
  "end": 9.5,
  "text": "排队"
 },
 {
  "start": 10.25,
  "end": 11.5,
  "text": "你知不知道这位是谁"
 },
 {
  "start": 14.0,
  "end": 15.0,
  "text": "排队就排队"
 },
 {
  "start": 15.0,
  "end": 16.25,
  "text": "哎呦孟总"
 },
 {
  "start": 16.25,
  "end": 17.25,
  "text": "您怎么来了"
 },
 {
  "start": 18.25,
  "end": 19.0,
  "text": "你认识我"
 },
 {
  "start": 19.0,
  "end": 19.75,
  "text": "当然认识"
 },
 {
  "start": 19.75,
  "end": 22.5,
  "text": "您可是云庭酒店的采购总监孟启年"
 },
 {
  "start": 22.5,
  "end": 24.75,
  "text": "我店里之前还给您送过员工餐"
 },
 {
  "start": 25.0,
  "end": 26.5,
  "text": "这汤给我来一碗"
 },
 {
  "start": 31.0,
  "end": 31.75,
  "text": "奇怪"
 },
 {
  "start": 32.25,
  "end": 33.25,
  "text": "鸡骨打底"
 },
 {
  "start": 33.5,
  "end": 34.5,
  "text": "猪骨托位"
 },
 {
  "start": 35.0,
  "end": 36.75,
  "text": "还有一点火腿边香"
 },
 {
  "start": 37.75,
  "end": 39.0,
  "text": "可为什么这么清"
 },
 {
  "start": 40.0,
  "end": 40.5,
  "text": "你懂汤"
 },
 {
  "start": 41.25,
  "end": 42.0,
  "text": "略懂"
 },
 {
  "start": 42.25,
  "end": 43.25,
  "text": "那你喝"
 },
 {
  "start": 48.0,
  "end": 49.0,
  "text": "孟总您没事吧"
 },
 {
  "start": 50.5,
  "end": 52.5,
  "text": "师傅敢问您贵姓"
 },
 {
  "start": 53.75,
  "end": 54.5,
  "text": "陆师傅"
 },
 {
  "start": 54.75,
  "end": 55.75,
  "text": "您这汤"
 },
 {
  "start": 55.75,
  "end": 57.5,
  "text": "能不能给我们云庭酒店供"
 },
 {
  "start": 57.75,
  "end": 59.0,
  "text": "孟总您说什么"
 },
 {
  "start": 59.5,
  "end": 60.25,
  "text": "后天"
 },
 {
  "start": 60.25,
  "end": 62.0,
  "text": "我们酒店有一场重要宴席"
 },
 {
  "start": 62.25,
  "end": 63.5,
  "text": "缺一道开席汤"
 },
 {
  "start": 63.75,
  "end": 65.25,
  "text": "如果您愿意出手"
 },
 {
  "start": 65.5,
  "end": 67.0,
  "text": "我按一碗三百收"
 },
 {
  "start": 68.5,
  "end": 69.75,
  "text": "三百一碗"
 },
 {
  "start": 70.75,
  "end": 73.25,
  "text": "我的天刚才28我还嫌贵"
 },
 {
  "start": 73.25,
  "end": 74.5,
  "text": "转眼就300了"
 },
 {
  "start": 74.5,
  "end": 75.75,
  "text": "酒店就是酒店"
 },
 {
  "start": 75.75,
  "end": 77.0,
  "text": "出手真不一样"
 },
 {
  "start": 77.25,
  "end": 78.0,
  "text": "不供"
 },
 {
  "start": 78.75,
  "end": 81.0,
  "text": "陆师傅是价格不满意"
 },
 {
  "start": 81.75,
  "end": 83.75,
  "text": "一碗汤值多少钱"
 },
 {
  "start": 83.75,
  "end": 84.75,
  "text": "不是你说了算"
 },
 {
  "start": 85.25,
  "end": 86.5,
  "text": "那您开价"
 },
 {
  "start": 87.5,
  "end": 89.25,
  "text": "我不去酒店后厨"
 },
 {
  "start": 90.0,
  "end": 90.75,
  "text": "为什么"
 },
 {
  "start": 92.75,
  "end": 93.75,
  "text": "规矩太多"
 },
 {
  "start": 94.5,
  "end": 95.75,
  "text": "脏事更多"
 },
 {
  "start": 96.0,
  "end": 97.5,
  "text": "孟总您看见了吧"
 },
 {
  "start": 97.5,
  "end": 99.0,
  "text": "这老头不识抬举"
 },
 {
  "start": 99.25,
  "end": 101.75,
  "text": "要不您考虑考虑我店里的招牌骨汤"
 },
 {
  "start": 101.75,
  "end": 103.0,
  "text": "我们设备齐全"
 },
 {
  "start": 103.0,
  "end": 104.0,
  "text": "价格也低"
 },
 {
  "start": 105.0,
  "end": 107.0,
  "text": "你那汤我喝过"
 },
 {
  "start": 107.5,
  "end": 109.25,
  "text": "不怎么样"
 },
 {
  "start": 109.75,
  "end": 112.25,
  "text": "陆师傅那您怎样才肯出手"
 },
 {
  "start": 115.5,
  "end": 117.25,
  "text": "这家店要续租"
 },
 {
  "start": 118.5,
  "end": 119.0,
  "text": "陆叔"
 },
 {
  "start": 119.5,
  "end": 121.25,
  "text": "房东要涨租也可以"
 },
 {
  "start": 121.5,
  "end": 122.75,
  "text": "但不能有人使绊子"
 },
 {
  "start": 124.25,
  "end": 126.75,
  "text": "你刚才说这家店房东是你表舅"
 },
 {
  "start": 127.0,
  "end": 129.0,
  "text": "孟总我刚才就是开个玩笑"
 },
 {
  "start": 129.0,
  "end": 130.5,
  "text": "我不喜欢这种玩笑"
 },
 {
  "start": 131.75,
  "end": 133.0,
  "text": "李总"
 },
 {
  "start": 133.0,
  "end": 135.25,
  "text": "半盏巷十八号那间铺子我要租"
 },
 {
  "start": 135.5,
  "end": 136.5,
  "text": "对现在"
 },
 {
  "start": 137.0,
  "end": 138.25,
  "text": "我不做生意"
 },
 {
  "start": 138.5,
  "end": 139.25,
  "text": "我送人"
 },
 {
  "start": 141.75,
  "end": 144.25,
  "text": "陆师傅房东那边我已经谈好了"
 },
 {
  "start": 144.25,
  "end": 145.25,
  "text": "从今天起"
 },
 {
  "start": 145.5,
  "end": 147.0,
  "text": "这间铺子签5年"
 },
 {
  "start": 147.25,
  "end": 148.75,
  "text": "租金我付"
 },
 {
  "start": 149.5,
  "end": 150.75,
  "text": "合同下午送来"
 },
 {
  "start": 153.75,
  "end": 155.25,
  "text": "孟总这怎么行"
 },
 {
  "start": 155.75,
  "end": 158.0,
  "text": "夏老板你不用谢我"
 },
 {
  "start": 158.5,
  "end": 159.75,
  "text": "我不是帮你"
 },
 {
  "start": 160.5,
  "end": 162.25,
  "text": "我是怕这口汤断了"
 },
 {
  "start": 164.25,
  "end": 167.0,
  "text": "陆师傅现在可以谈宴席了吗"
 },
 {
  "start": 168.0,
  "end": 169.0,
  "text": "后天什么宴"
 },
 {
  "start": 169.5,
  "end": 171.25,
  "text": "云庭酒店20周年庆"
 },
 {
  "start": 171.75,
  "end": 173.0,
  "text": "来的都是什么人"
 },
 {
  "start": 173.5,
  "end": 175.0,
  "text": "江州餐饮协会"
 },
 {
  "start": 175.0,
  "end": 176.25,
  "text": "几位美食评委"
 },
 {
  "start": 176.5,
  "end": 178.75,
  "text": "还有一位从京城来的老先生"
 },
 {
  "start": 179.25,
  "end": 188.5,
  "text": "想起二十年前，京城那场宴席上，也有一位姓顾的老食客。他喝完我的清汤，连说三声可惜。",
  "layer": "top"
 },
 {
  "start": 179.25,
  "end": 184.75,
  "text": "可惜"
 },
 {
  "start": 184.75,
  "end": 187.5,
  "text": "哎可惜我当时不肯留在京城"
 },
 {
  "start": 187.5,
  "end": 188.5,
  "text": "难不成是他"
 },
 {
  "start": 189.75,
  "end": 191.75,
  "text": "陆师傅您认识"
 },
 {
  "start": 192.0,
  "end": 192.75,
  "text": "不认识"
 },
 {
  "start": 194.5,
  "end": 196.25,
  "text": "后天我可以去"
 },
 {
  "start": 196.75,
  "end": 197.5,
  "text": "太好了"
 },
 {
  "start": 199.25,
  "end": 200.75,
  "text": "不过我有个条件"
 },
 {
  "start": 201.75,
  "end": 202.25,
  "text": "您说"
 },
 {
  "start": 203.0,
  "end": 205.25,
  "text": "这场宴我不做别的"
 },
 {
  "start": 206.0,
  "end": 207.25,
  "text": "只做一碗汤"
 },
 {
  "start": 207.25,
  "end": 209.25,
  "text": "哈哈哈老头"
 },
 {
  "start": 209.25,
  "end": 211.0,
  "text": "你还真把自己当人物了"
 },
 {
  "start": 211.25,
  "end": 213.0,
  "text": "云庭酒店20周年庆"
 },
 {
  "start": 213.0,
  "end": 214.25,
  "text": "你就做一碗汤"
 },
 {
  "start": 214.5,
  "end": 215.75,
  "text": "你知不知道那种场合"
 },
 {
  "start": 215.75,
  "end": 217.25,
  "text": "来的都是什么贵客"
 },
 {
  "start": 217.25,
  "end": 218.75,
  "text": "正因为是贵客"
 },
 {
  "start": 219.25,
  "end": 221.25,
  "text": "所以一碗汤就够了"
 },
 {
  "start": 222.0,
  "end": 224.25,
  "text": "好我信您"
 },
 {
  "start": 224.5,
  "end": 226.5,
  "text": "孟总您会后悔的"
 },
 {
  "start": 226.5,
  "end": 228.25,
  "text": "这年头会营销的多了"
 },
 {
  "start": 228.5,
  "end": 231.25,
  "text": "一锅汤吹得再神也上不了大台"
 },
 {
  "start": 231.75,
  "end": 232.25,
  "text": "冯耀祖"
 },
 {
  "start": 233.5,
  "end": 235.25,
  "text": "后天你也来"
 },
 {
  "start": 235.75,
  "end": 237.0,
  "text": "我为什么要来"
 },
 {
  "start": 237.5,
  "end": 239.0,
  "text": "看看什么叫真正的汤"
 },
 {
  "start": 239.5,
  "end": 240.25,
  "text": "顺便学学"
 },
 {
  "start": 241.0,
  "end": 242.75,
  "text": "免得以后开一辈子店"
 },
 {
  "start": 242.75,
  "end": 244.5,
  "text": "连锅洗锅水都熬不明白"
 },
 {
  "start": 245.5,
  "end": 247.25,
  "text": "哈哈哈"
 },
 {
  "start": 248.5,
  "end": 250.25,
  "text": "陆爷爷咱们是不是发财了"
 },
 {
  "start": 250.5,
  "end": 251.25,
  "text": "还早"
 },
 {
  "start": 251.25,
  "end": 252.75,
  "text": "那什么时候才算发财"
 },
 {
  "start": 252.75,
  "end": 253.75,
  "text": "等这碗汤"
 },
 {
  "start": 253.75,
  "end": 255.5,
  "text": "端上云庭酒店那张主桌"
 },
 {
  "start": 255.75,
  "end": 257.75,
  "text": "让那些真正懂吃的人站起来"
 },
 {
  "start": 258.25,
  "end": 259.75,
  "text": "那才算刚刚开始"
 },
 {
  "start": 260.5,
  "end": 263.0,
  "text": "陆师傅这是云庭酒店的预付款"
 },
 {
  "start": 263.0,
  "end": 263.75,
  "text": "多少"
 },
 {
  "start": 264.25,
  "end": 265.5,
  "text": "10万"
 },
 {
  "start": 265.5,
  "end": 267.75,
  "text": "后天那场宴对我们云庭很重要"
 },
 {
  "start": 268.0,
  "end": 270.0,
  "text": "如果您这碗汤真能镇住全场"
 },
 {
  "start": 270.25,
  "end": 271.0,
  "text": "尾款另算"
 },
 {
  "start": 275.0,
  "end": 277.5,
  "text": "10万块是不是能买好多好多鸡"
 },
 {
  "start": 277.75,
  "end": 280.25,
  "text": "傻小子鸡架才几个钱"
 },
 {
  "start": 280.5,
  "end": 283.0,
  "text": "陆师傅这孩子有意思呵"
 },
 {
  "start": 285.25,
  "end": 285.75,
  "text": "南枝"
 },
 {
  "start": 286.25,
  "end": 287.5,
  "text": "把卡收着"
 },
 {
  "start": 288.5,
  "end": 290.75,
  "text": "陆叔这钱我不能拿"
 },
 {
  "start": 291.0,
  "end": 292.25,
  "text": "谁让你拿了"
 },
 {
  "start": 295.0,
  "end": 296.5,
  "text": "这钱是买东西用的"
 },
 {
  "start": 296.5,
  "end": 297.25,
  "text": "买什么"
 },
 {
  "start": 298.25,
  "end": 299.75,
  "text": "买锅买灶"
 },
 {
  "start": 300.5,
  "end": 301.25,
  "text": "买刀架"
 },
 {
  "start": 301.75,
  "end": 303.0,
  "text": "再给你和知味"
 },
 {
  "start": 303.0,
  "end": 304.25,
  "text": "换两身像样的衣服"
 },
 {
  "start": 305.25,
  "end": 306.25,
  "text": "后天去云庭"
 },
 {
  "start": 306.75,
  "end": 308.0,
  "text": "不能让人看扁了"
 },
 {
  "start": 308.75,
  "end": 310.5,
  "text": "陆叔我就不去了吧"
 },
 {
  "start": 310.5,
  "end": 312.5,
  "text": "那种地方我怕给您丢人"
 },
 {
  "start": 312.75,
  "end": 313.5,
  "text": "抬起头"
 },
 {
  "start": 316.0,
  "end": 316.75,
  "text": "做饭的人"
 },
 {
  "start": 317.25,
  "end": 318.5,
  "text": "手上可以有茧"
 },
 {
  "start": 319.25,
  "end": 320.25,
  "text": "衣服可以旧"
 },
 {
  "start": 320.5,
  "end": 321.75,
  "text": "但腰不能弯"
 },
 {
  "start": 322.0,
  "end": 323.5,
  "text": "你是半盏巷的老板娘"
 },
 {
  "start": 323.75,
  "end": 325.0,
  "text": "不是谁家的丫鬟"
 },
 {
  "start": 326.75,
  "end": 327.25,
  "text": "陆叔"
 },
 {
  "start": 329.25,
  "end": 330.0,
  "text": "还有你"
 },
 {
  "start": 332.0,
  "end": 334.0,
  "text": "明天开始不许再穿这"
 },
 {
  "start": 334.0,
  "end": 335.25,
  "text": "双开胶的鞋去学校"
 },
 {
  "start": 335.5,
  "end": 337.25,
  "text": "陆爷爷我这鞋还能穿"
 },
 {
  "start": 337.25,
  "end": 338.25,
  "text": "能穿也换"
 },
 {
  "start": 338.5,
  "end": 339.5,
  "text": "人要省钱"
 },
 {
  "start": 339.5,
  "end": 340.5,
  "text": "但不能省掉体面"
 },
 {
  "start": 340.5,
  "end": 342.5,
  "text": "好耶姐可以吗"
 },
 {
  "start": 343.25,
  "end": 344.0,
  "text": "听陆爷爷的"
 },
 {
  "start": 345.0,
  "end": 347.5,
  "text": "陆叔这地方太贵了"
 },
 {
  "start": 347.75,
  "end": 348.75,
  "text": "贵有贵的道理"
 },
 {
  "start": 349.0,
  "end": 350.75,
  "text": "可咱们还没真正赚到钱"
 },
 {
  "start": 351.0,
  "end": 354.0,
  "text": "南枝钱花在虚荣上叫败家"
 },
 {
  "start": 354.0,
  "end": 355.75,
  "text": "花在本事上叫底气"
 },
 {
  "start": 358.5,
  "end": 359.5,
  "text": "几位随便看看"
 },
 {
  "start": 359.75,
  "end": 361.25,
  "text": "这口砂锅怎么卖"
 },
 {
  "start": 361.25,
  "end": 363.5,
  "text": "那是手工黑陶锅三千八"
 },
 {
  "start": 364.25,
  "end": 365.75,
  "text": "一个锅三千八"
 },
 {
  "start": 365.75,
  "end": 367.25,
  "text": "我们这都是高端厨具"
 },
 {
  "start": 367.25,
  "end": 368.5,
  "text": "如果只是家里煮汤"
 },
 {
  "start": 368.75,
  "end": 370.25,
  "text": "旁边超市几十块也能买"
 },
 {
  "start": 373.5,
  "end": 374.25,
  "text": "这个拿两口"
 },
 {
  "start": 374.25,
  "end": 375.0,
  "text": "您确定"
 },
 {
  "start": 375.0,
  "end": 377.25,
  "text": "确定这口铜汤锅呢"
 },
 {
  "start": 377.25,
  "end": 377.75,
  "text": "8,600"
 },
 {
  "start": 377.75,
  "end": 379.0,
  "text": "拿一头"
 },
 {
  "start": 379.0,
  "end": 380.0,
  "text": "还有这套砧板"
 },
 {
  "start": 380.0,
  "end": 380.75,
  "text": "柳木的"
 },
 {
  "start": 380.75,
  "end": 382.25,
  "text": "是老师傅手作"
 },
 {
  "start": 383.0,
  "end": 383.75,
  "text": "包起来"
 },
 {
  "start": 384.0,
  "end": 385.25,
  "text": "陆叔太贵了"
 },
 {
  "start": 385.25,
  "end": 386.5,
  "text": "真的太贵了"
 },
 {
  "start": 391.0,
  "end": 392.25,
  "text": "后天那场宴"
 },
 {
  "start": 392.75,
  "end": 394.25,
  "text": "只要这一锅汤成了"
 },
 {
  "start": 394.25,
  "end": 396.75,
  "text": "这些东西一天就能挣回来"
 },
 {
  "start": 397.25,
  "end": 398.5,
  "text": "可万一不成呢"
 },
 {
  "start": 399.25,
  "end": 400.25,
  "text": "不会不成"
 },
 {
  "start": 400.25,
  "end": 401.0,
  "text": "为什么"
 },
 {
  "start": 401.25,
  "end": 402.5,
  "text": "因为我这双手"
 },
 {
  "start": 403.0,
  "end": 404.5,
  "text": "还没老到那个份上"
 },
 {
  "start": 404.75,
  "end": 406.25,
  "text": "先生您是厨师"
 },
 {
  "start": 406.25,
  "end": 407.0,
  "text": "算是吧"
 },
 {
  "start": 407.0,
  "end": 408.5,
  "text": "您在哪家酒店掌勺"
 },
 {
  "start": 408.5,
  "end": 409.75,
  "text": "现在在半盏巷"
 },
 {
  "start": 410.0,
  "end": 410.75,
  "text": "半盏巷"
 },
 {
  "start": 412.25,
  "end": 414.5,
  "text": "陆爷爷我是不是像城里小孩了"
 },
 {
  "start": 416.0,
  "end": 418.0,
  "text": "知味你本来就是城里小孩"
 },
 {
  "start": 418.5,
  "end": 421.75,
  "text": "以前同学说我身上一股油烟味"
 },
 {
  "start": 424.75,
  "end": 426.25,
  "text": "油烟味不丢人"
 },
 {
  "start": 427.5,
  "end": 428.75,
  "text": "靠自己双手吃饭的人"
 },
 {
  "start": 429.0,
  "end": 430.75,
  "text": "身上什么味都不丢人"
 },
 {
  "start": 430.75,
  "end": 432.25,
  "text": "可是他们笑我"
 },
 {
  "start": 433.75,
  "end": 435.25,
  "text": "那就好好读书"
 },
 {
  "start": 435.75,
  "end": 437.0,
  "text": "好好长本事"
 },
 {
  "start": 437.75,
  "end": 439.0,
  "text": "等你有本事了"
 },
 {
  "start": 439.0,
  "end": 440.25,
  "text": "不用骂回去"
 },
 {
  "start": 440.5,
  "end": 441.5,
  "text": "站在那里"
 },
 {
  "start": 441.75,
  "end": 443.5,
  "text": "他们自己就会闭嘴"
 },
 {
  "start": 444.25,
  "end": 445.25,
  "text": "我记住了"
 },
 {
  "start": 448.0,
  "end": 450.75,
  "text": "陆叔今天已经花了快2万了"
 },
 {
  "start": 451.75,
  "end": 452.5,
  "text": "心疼"
 },
 {
  "start": 454.0,
  "end": 455.75,
  "text": "那就去吃顿好的"
 },
 {
  "start": 457.75,
  "end": 458.75,
  "text": "钱都花了"
 },
 {
  "start": 458.75,
  "end": 459.5,
  "text": "还差一顿饭"
 },
 {
  "start": 460.0,
  "end": 462.0,
  "text": "陆叔咱们回店里吃面就行"
 },
 {
  "start": 462.75,
  "end": 464.25,
  "text": "后天你要去云庭酒店"
 },
 {
  "start": 464.5,
  "end": 466.25,
  "text": "连高档餐厅的规矩都没见过"
 },
 {
  "start": 466.25,
  "end": 467.25,
  "text": "怎么镇得住场"
 },
 {
  "start": 468.5,
  "end": 470.0,
  "text": "那咱们吃便宜点的"
 },
 {
  "start": 470.0,
  "end": 471.0,
  "text": "看情况"
 }
]